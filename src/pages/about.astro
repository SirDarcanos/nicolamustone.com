---
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import Layout from "../layouts/Layout.astro";
import Label from "../components/Label.astro";
import SkillBadge from "../components/SkillBadge.astro";
import Stat from "../components/Stat.astro";
import TimelineEntry from "../components/TimelineEntry.astro";

import { jobs, stats, skills, yearsInCareer } from "../data/data";

const skillGroups = [
  { title: "Humans", label: "Leading & Coaching", items: skills.human },
  { title: "Machines", label: "Building & Code", items: skills.tech },
  { title: "Exploring", label: "Curiosity & Data", items: skills.exploring },
];
---

<Layout
  title="About Nicola Mustone — Maker of Apps and Websites"
  description="Meet Nicola Mustone, the person behind this collection of apps, developer tools, essays, and independent websites, with a background in support and web development."
  type="profile"
  markdown
>
  {/* INTRO */}
  <Container
    section
    id="intro"
    className="space-y-4 text-center md:max-w-xl md:text-left"
  >
    <Label>All about me</Label>
    <h1 id="name" class="mt-3 mb-10 text-4xl">Hi, I'm Nico.</h1>
    <p>
      I've worked in web development and customer support since 2010, from
      freelance sites and WordPress products to support operations and team
      leadership.
    </p>
    <p>
      Today I lead a support team at Automattic, working across WordPress.com
      and WooCommerce. Away from the support dashboard, I build small sites, run
      D&D adventures, and cook things I have strong opinions about.
    </p>
    <p>
      <Button href="/#projects" ghost>Explore the projects I make</Button>
    </p>
  </Container>

  {/* STATS */}
  <Container
    id="stats"
    className="grid grid-cols-1 gap-2 text-center md:grid-cols-3 md:text-left lg:grid-cols-5"
  >
    {stats.map((stat) => <Stat {...stat} />)}
  </Container>

  {/* SKILLS STACK */}
  <Container section id="skills">
    <h2>What I work with</h2>

    {
      skillGroups.map((group) => (
        <div class="border-line bg-surface mt-10 grid grid-cols-1 gap-6 rounded-xl border p-10 md:grid-cols-[1fr_3fr]">
          <section>
            <h3 class="text-lg">{group.title}</h3>
            <p class="text-accent mt-1 font-mono text-xs uppercase">
              {group.label}
            </p>
          </section>
          <div class="flex flex-wrap gap-2">
            {group.items.map((skill) => (
              <SkillBadge>{skill}</SkillBadge>
            ))}
          </div>
        </div>
      ))
    }
  </Container>

  {/* EXPERIENCE */}
  <Container section id="experience">
    <h2>My experience</h2>
    <div class="mt-10">
      {jobs.map((job) => <TimelineEntry {...job} />)}
    </div>
  </Container>
</Layout>
