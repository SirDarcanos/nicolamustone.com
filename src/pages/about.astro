---
import Button from "../components/Button.astro";
import Container from "../components/Container.astro";
import Layout from "../layouts/Layout.astro";
import Label from "../components/Label.astro";
import SkillBadge from "../components/SkillBadge.astro";
import Stat from "../components/Stat.astro";
import TimelineEntry from "../components/TimelineEntry.astro";
import modernWarfareArtwork from "../assets/games/modern-warfare-4.webp";
import helldiversArtwork from "../assets/games/helldivers-2.webp";

import { jobs, stats, skills } from "../data/data";

// Artwork from each game's official PlayStation page, stored locally.
const currentlyPlaying = [
  {
    name: "Call of Duty: Modern Warfare 4",
    platform: "PS5",
    href: "https://www.playstation.com/en-ro/games/call-of-duty-modern-warfare-4/",
    artwork: modernWarfareArtwork,
  },
  {
    name: "Helldivers 2",
    platform: "PS5",
    href: "https://www.playstation.com/en-ro/games/helldivers-2/",
    artwork: helldiversArtwork,
  },
];

const skillGroups = [
  { title: "Humans", label: "Leading & Coaching", items: skills.human },
  { title: "Machines", label: "Building & Code", items: skills.tech },
  { title: "Exploring", label: "Curiosity & Data", items: skills.exploring },
];
---

<Layout
  title="About Nicola Mustone — Maker of Apps and Websites"
  description="Meet Nicola Mustone, the person behind this collection of apps, developer tools, essays, and independent websites, with a background in support and web development."
  type="profile"
  markdown
>
  {/* INTRO */}
  <Container
    section
    id="intro"
    className="space-y-4 text-center md:max-w-xl md:text-left"
  >
    <Label>All about me</Label>
    <h1 id="name" class="mt-3 mb-10 text-4xl">Hi, I'm Nico.</h1>
    <p>
      I've worked in web development and customer support since 2010, from
      freelance sites and WordPress products to support operations and team
      leadership.
    </p>
    <p>
      Today I lead a support team at Automattic, working across WordPress.com
      and WooCommerce. Away from the support dashboard, I build small sites, run
      D&D adventures, and cook things I have strong opinions about.
    </p>
    <Button href="/#projects" ghost>Explore the projects I make</Button>
  </Container>

  {/* STATS */}
  <Container
    id="stats"
    className="grid grid-cols-1 gap-2 text-center md:grid-cols-3 md:text-left lg:grid-cols-5"
  >
    {stats.map((stat) => <Stat {...stat} />)}
  </Container>

  {/* SKILLS STACK */}
  <Container section id="skills">
    <h2>What I work with</h2>

    {
      skillGroups.map((group) => (
        <div class="border-line bg-surface mt-10 grid grid-cols-1 gap-6 rounded-xl border p-10 md:grid-cols-[1fr_3fr]">
          <section>
            <h3 class="text-lg">{group.title}</h3>
            <p class="text-accent mt-1 font-mono text-xs uppercase">
              {group.label}
            </p>
          </section>
          <div class="flex flex-wrap gap-2">
            {group.items.map((skill) => (
              <SkillBadge>{skill}</SkillBadge>
            ))}
          </div>
        </div>
      ))
    }
  </Container>

  {/* EXPERIENCE */}
  <Container section id="experience">
    <h2>My experience</h2>
    <div class="mt-10">
      {jobs.map((job) => <TimelineEntry {...job} />)}
    </div>
  </Container>

  {/* CURRENTLY PLAYING */}
  <Container section id="currently-playing" aria-labelledby="playing-heading">
    <h2 id="playing-heading">Currently playing</h2>
    <ul class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        currentlyPlaying.map((game) => (
          <li>
            <a
              href={game.href}
              target="_blank"
              rel="noopener noreferrer"
              class="group relative flex aspect-[4/3] flex-col justify-end overflow-hidden rounded-xl bg-black p-6 text-white hover:text-white focus-visible:outline-offset-4"
            >
              <img
                src={game.artwork.src}
                alt=""
                width={game.artwork.width}
                height={game.artwork.height}
                loading="lazy"
                decoding="async"
                class="absolute inset-0 h-full w-full object-cover object-right motion-safe:transition-transform motion-safe:duration-300 motion-safe:group-hover:scale-105"
              />
              <span
                aria-hidden="true"
                class="absolute inset-0 bg-linear-to-t from-black via-black/60 to-black/10"
              />
              <span class="absolute top-4 right-4 rounded border border-white/30 bg-black/70 px-2 py-1 font-mono text-xs tracking-wide">
                {game.platform}
              </span>
              <h3 class="relative max-w-[16rem] text-xl text-white md:text-2xl">
                {game.name}
              </h3>
            </a>
          </li>
        ))
      }
    </ul>
  </Container>
</Layout>
