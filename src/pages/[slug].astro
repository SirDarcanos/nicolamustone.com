---
import { getEntries, render } from "astro:content";
import Button from "../components/Button.astro";
import Layout from "../layouts/Layout.astro";
import RelatedProjects from "../components/RelatedProjects.astro";
import { getProjects, type Project } from "../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { Content } = await render(project);
const relatedProjects = await getEntries(
  project.data.relatedProjects.map(({ project }) => project),
);
const relatedProjectCards = relatedProjects.map((relatedProject, index) => ({
  project: relatedProject,
  description: project.data.relatedProjects[index].description,
}));
const {
  title,
  description,
  seoTitle,
  seoDescription,
  launchedAt,
  tags,
  status,
} = project.data;
---

<Layout
  title={seoTitle}
  description={seoDescription}
  type="article"
  article={project}
  markdown
>
  <article id={`project-${project.id}`} class="mt-20">
    <header class="text-center md:max-w-xl md:text-left">
      <p class="font-mono text-sm uppercase">
        {
          tags.map((tag) => (
            <>
              <span class="text-accent">{tag}</span>
              <span class="text-faint"> / </span>
            </>
          ))
        }
        <time datetime={launchedAt.toISOString()} class="text-faint">
          {
            launchedAt.toLocaleDateString("en-RO", {
              year: "numeric",
              month: "short",
            })
          }
        </time>
        {
          status === "archived" && (
            <span class="bg-accent-soft text-accent ml-2 inline-block px-2 py-1 align-middle font-mono text-xs font-light uppercase">
              Archived
            </span>
          )
        }
      </p>
      <h1 class="mt-3 mb-10 text-4xl">{title}</h1>
      <p class="text-muted mt-4 text-xl">{description}</p>
    </header>

    <div class="post-content mt-7">
      <Content />
    </div>
  </article>

  <RelatedProjects projects={relatedProjectCards} />

  <footer class="border-line mt-15 border-t py-10">
    <Button href="/#projects" ghost>← Back to all projects</Button>
  </footer>
</Layout>
