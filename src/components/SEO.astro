---
import type { Entry } from "../lib/wordpress";

const SITE_URL = "https://nicolamustone.com";
const SITE_NAME = "Nicola Mustone";
const DEFAULT_DESCRIPTION =
  "Support Lead at Automattic by day, maker of small, sharp side projects the rest of the time — D&D tools, a dice library, fan archives, and real carbonara.";
/* Both cards are generated by scripts/generate-images.mjs at 1200x630 and served
   from this domain, so they never depend on the WordPress media host being
   reachable. Pass ogImage="/og-plain.png" on any page that shouldn't lead with
   the photo. */
const DEFAULT_OG_IMAGE = "/og.png";
const GENERATED_CARDS = ["/og.png", "/og-plain.png"].map(
  (path) => new URL(path, SITE_URL).href,
);
const DEFAULT_OG_IMAGE_ALT = `${SITE_NAME} — does things and ships them`;
const TWITTER_HANDLE = "@nicolamustone";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  type?: "website" | "article" | "profile";
  article?: Entry;
  noindex?: boolean;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  canonical = new URL(Astro.url.pathname, SITE_URL).href,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt,
  type = "website",
  article,
  noindex = false,
} = Astro.props;

/* Pages that already lead with the site name (the homepage) shouldn't repeat it. */
const fullTitle = title.includes(SITE_NAME) ? title : `${title} — ${SITE_NAME}`;
const resolvedCanonical = article?.seo.canonical ?? canonical;
/* Social crawlers need an absolute URL, so relative paths get resolved here.
   Already-absolute WordPress image URLs pass through untouched. */
const resolvedOgImage = new URL(article?.seo.ogImage ?? ogImage, SITE_URL).href;
const resolvedOgImageAlt =
  ogImageAlt ?? (article ? article.title : DEFAULT_OG_IMAGE_ALT);
/* Dimensions are only known for the cards we generate ourselves — WordPress
   featured images come through at whatever size they were uploaded at. */
const isGeneratedCard = GENERATED_CARDS.includes(resolvedOgImage);

const PERSON = {
  "@type": "Person",
  name: SITE_NAME,
  url: SITE_URL,
  sameAs: [
    "https://bsky.app/profile/nicolamustone.bsky.social",
    "https://github.com/SirDarcanos",
    "https://indieweb.social/@nicolamustone",
    "https://profiles.wordpress.org/nicolamustone/",
    "https://www.linkedin.com/in/nicolamustone/",
    "https://x.com/nicolamustone",
  ],
};

const jsonLd: Record<string, unknown>[] = [
  { "@context": "https://schema.org", ...PERSON },
];

if (type === "website") {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_NAME,
    url: SITE_URL,
    description: DEFAULT_DESCRIPTION,
  });
}

if (type === "profile") {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    name: fullTitle,
    url: resolvedCanonical,
    mainEntity: PERSON,
  });
}

if (article) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "Article",
    headline: article.title,
    description: article.seo.description,
    url: article.seo.canonical,
    datePublished: article.date,
    dateModified: article.modified,
    ...(article.featuredImage ? { image: article.featuredImage } : {}),
    author: PERSON,
    publisher: PERSON,
    mainEntityOfPage: article.seo.canonical,
  });
}
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={resolvedCanonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

{/* Open Graph */}
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:alt" content={resolvedOgImageAlt} />
{
  isGeneratedCard && (
    <>
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </>
  )
}
<meta property="og:locale" content="en_US" />
{
  article && (
    <>
      <meta property="article:published_time" content={article.date} />
      <meta property="article:modified_time" content={article.modified} />
      <meta property="article:author" content={SITE_NAME} />
    </>
  )
}

{/* Twitter Card */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />
<meta name="twitter:image:alt" content={resolvedOgImageAlt} />
<meta name="twitter:site" content={TWITTER_HANDLE} />
<meta name="twitter:creator" content={TWITTER_HANDLE} />

{/* JSON-LD */}
{
  jsonLd.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
