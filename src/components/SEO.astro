---
import type { Project } from "../lib/projects";

const SITE_URL = "https://nicolamustone.com";
const SITE_NAME = "Nicola Mustone";
const DEFAULT_DESCRIPTION =
  "Support Lead at Automattic by day, maker of small, sharp side projects the rest of the time — D&D tools, a dice library, fan archives, and real carbonara.";
const DEFAULT_OG_IMAGE = "/og.png";
const GENERATED_CARDS = ["/og.png", "/og-plain.png"].map(
  (path) => new URL(path, SITE_URL).href,
);
const DEFAULT_OG_IMAGE_ALT = `${SITE_NAME} — does things and ships them`;
const TWITTER_HANDLE = "@nicolamustone";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  type?: "website" | "article" | "profile";
  article?: Project;
  noindex?: boolean;
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  canonical = new URL(Astro.url.pathname, SITE_URL).href,
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt,
  type = "website",
  article,
  noindex = false,
} = Astro.props;

const fullTitle = title.includes(SITE_NAME) ? title : `${title} — ${SITE_NAME}`;
const resolvedCanonical = article
  ? new URL(`/${article.id}/`, SITE_URL).href
  : canonical;
const articleImage = article?.data.featuredImage.src;
const resolvedOgImage = new URL(articleImage ?? ogImage, SITE_URL).href;
const resolvedOgImageAlt =
  ogImageAlt ?? article?.data.featuredImageAlt ?? DEFAULT_OG_IMAGE_ALT;
const isGeneratedCard = GENERATED_CARDS.includes(resolvedOgImage);

const PERSON_ID = `${SITE_URL}/#person`;
const PERSON_REFERENCE = { "@id": PERSON_ID };
const PERSON = {
  "@type": "Person",
  "@id": PERSON_ID,
  name: SITE_NAME,
  url: SITE_URL,
  sameAs: [
    "https://bsky.app/profile/nicolamustone.bsky.social",
    "https://github.com/SirDarcanos",
    "https://indieweb.social/@nicolamustone",
    "https://profiles.wordpress.org/nicolamustone/",
    "https://www.linkedin.com/in/nicolamustone/",
    "https://x.com/nicolamustone",
  ],
};

const jsonLd: Record<string, unknown>[] = [
  { "@context": "https://schema.org", ...PERSON },
];

if (type === "website") {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: SITE_NAME,
    url: SITE_URL,
    description,
    creator: PERSON_REFERENCE,
  });
}

if (type === "profile") {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "ProfilePage",
    name: fullTitle,
    url: resolvedCanonical,
    mainEntity: PERSON_REFERENCE,
  });
}

if (article) {
  jsonLd.push({
    "@context": "https://schema.org",
    "@type": "CreativeWork",
    name: article.data.title,
    description: article.data.description,
    url: resolvedCanonical,
    dateCreated: article.data.launchedAt.toISOString(),
    image: resolvedOgImage,
    creator: PERSON_REFERENCE,
    mainEntityOfPage: resolvedCanonical,
  });
}
---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={resolvedCanonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:image" content={resolvedOgImage} />
<meta property="og:image:alt" content={resolvedOgImageAlt} />
{
  isGeneratedCard && (
    <>
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
    </>
  )
}
<meta property="og:locale" content="en_US" />
{
  article && (
    <meta
      property="article:published_time"
      content={article.data.launchedAt.toISOString()}
    />
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={resolvedOgImage} />
<meta name="twitter:image:alt" content={resolvedOgImageAlt} />
<meta name="twitter:site" content={TWITTER_HANDLE} />
<meta name="twitter:creator" content={TWITTER_HANDLE} />

{
  jsonLd.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
