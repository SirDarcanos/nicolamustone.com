---
interface Props {
  href: string;
}

const { href } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noreferrer noopener"
  class="project-link border-line bg-surface text-faint mt-6 flex w-full rounded-lg border px-4 py-2 font-mono text-sm"
>
  <slot />
</a>

<style>
  .project-link :global(p) {
    margin: 0;
  }
</style>
