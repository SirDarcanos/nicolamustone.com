---
interface NavLink {
  href: string;
  label: string;
  rel?: string;
  nofollow?: boolean;
  blank?: boolean;
}

interface Props {
  links?: NavLink[];
  location?: string;
}

const {
  links = [
    { href: "/", label: "Home" },
    { href: "/about/", label: "About" },
  ],
  location,
} = Astro.props;

const path = Astro.url.pathname;

/* `rel` carries identity tokens like "me", which Mastodon and IndieAuth read to
   verify a profile links back here. nofollow/noopener are layered on top. */
function relFor(link: NavLink) {
  const tokens = [
    link.rel,
    link.nofollow && "nofollow",
    link.blank && "noopener noreferrer",
  ].filter(Boolean);

  return tokens.length ? tokens.join(" ") : undefined;
}
---

<nav class="flex gap-6 font-mono md:items-end">
  {
    links.map((link) => (
      <a
        href={link.href}
        aria-current={path === link.href ? "page" : undefined}
        class:list={[
          "aria-[current=page]:font-semibold",
          location === "footer" && "text-faint",
        ]}
        target={link.blank ? "_blank" : undefined}
        rel={relFor(link)}
      >
        {link.label}
      </a>
    ))
  }
</nav>
