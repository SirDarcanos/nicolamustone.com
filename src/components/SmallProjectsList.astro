---
import type { SmallProject } from "../data/data";

interface Props {
  projects: SmallProject[];
}

const { projects } = Astro.props;
---

<ul class="border-line border-t">
  {
    projects.map((project) => (
      <li class="border-line border-b px-2 py-5">
        <a
          href={project.href}
          target="_blank"
          rel="noreferrer noopener"
          class="group grid grid-cols-[minmax(0,1fr)_auto] gap-x-4 gap-y-1 no-underline sm:grid-cols-[minmax(0,0.8fr)_minmax(0,1.8fr)_auto] sm:items-baseline sm:gap-3"
        >
          <span class="text-ink font-display col-start-1 row-start-1 text-lg font-semibold">
            {project.title}
          </span>
          <span class="text-muted col-span-2 row-start-2 text-sm sm:col-span-1 sm:col-start-2 sm:row-start-1">
            {project.description}
          </span>
          <span
            aria-hidden="true"
            class="text-faint col-start-2 row-start-1 transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 sm:col-start-3"
          >
            ↗
          </span>
        </a>
      </li>
    ))
  }
</ul>
